---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="bg" page="technologies" title="Технологии | BentoConsult" description="Бентонитни решения, зеолитни решения, патенти и ноу-хау.">
<section class="relative py-16 lg:py-24 overflow-hidden"> <div class="absolute inset-0 bg-gradient-to-br from-navy via-graphite to-navy"></div> <div class="absolute inset-0"> <img src="/images/minerals_background.webp" alt="" class="w-full h-full object-cover opacity-40" aria-hidden="true" width="1536" height="1024" loading="lazy" decoding="async"> <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/60 to-navy/30"></div> </div> <div class="section-container relative"> <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">Технологии</h1> </div>
</section>
<section class="py-16 lg:py-20"> <div class="section-container max-w-3xl mx-auto space-y-6"> <div class="card"> <h2 class="text-xl font-semibold mb-2">Бентонитни решения</h2> <p class="text-gray-400">Разработка и внедряване на технологични процеси</p> </div> <div class="card"> <h2 class="text-xl font-semibold mb-2">Зеолитни решения</h2> <p class="text-gray-400">Иновативни материали и филтрация</p> </div> <div class="card"> <h2 class="text-xl font-semibold mb-2">Патенти и ноу-хау</h2> <p class="text-gray-400">Собствени разработки и технологии</p> </div> </div>
</section>
</Layout>
