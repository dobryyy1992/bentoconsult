---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" page="contacts" title="Contact Us — BentoConsult" description="We usually respond within 24 hours.">
<section class="py-16 lg:py-24 bg-gradient-to-b from-graphite/50 to-navy"> <div class="section-container text-center"> <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">Contact Us</h1> <p class="section-subtitle mx-auto mt-6">We usually respond within 24 hours.</p> </div>
</section>
<section class="py-16 lg:py-20"> <div class="section-container"><div class="grid lg:grid-cols-5 gap-12"> <div class="lg:col-span-3">
<form id="contact-form" class="space-y-6"> <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off"> <div class="grid md:grid-cols-2 gap-6"> <div> <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Name</label> <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg bg-graphite border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan/50 focus:border-cyan/50 transition-colors"> </div> <div> <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label> <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg bg-graphite border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan/50 focus:border-cyan/50 transition-colors"> </div> </div> <div> <label for="company" class="block text-sm font-medium text-gray-300 mb-2">Company</label> <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-lg bg-graphite border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan/50 focus:border-cyan/50 transition-colors"> </div> <div> <label for="message" class="block text-sm font-medium text-gray-300 mb-2">Message</label> <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg bg-graphite border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan/50 focus:border-cyan/50 transition-colors resize-y"></textarea> </div> <button type="submit" class="btn-primary w-full md:w-auto" id="submit-btn">Send Message</button> <p id="form-status" class="text-sm mt-2 hidden"></p> </form> </div> <div class="lg:col-span-2 space-y-6"> <div class="card space-y-4"> <a href="mailto:office@bento-health.com" class="flex items-center gap-3 text-gray-300 hover:text-cyan transition-colors group"> <div class="w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center group-hover:bg-cyan/20 transition-colors"> <svg class="w-5 h-5 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> </div> <span>office@bento-health.com</span> </a> <a href="tel:+359888702144" class="flex items-center gap-3 text-gray-300 hover:text-cyan transition-colors group"> <div class="w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center group-hover:bg-cyan/20 transition-colors"> <svg class="w-5 h-5 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg> </div> <div><span>+359 88 870 2144</span><span class="block text-xs text-gray-500">Viber, WhatsApp, WeChat</span></div> </a> </div> </div> </div></div>
</section>
  <script>
    import '../../scripts/contactForm';
  </script>
</Layout>
