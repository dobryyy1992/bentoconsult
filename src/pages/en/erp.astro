---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" page="erp" title="ERP Architecture | BentoConsult" description="ERP is a tool. Without a system, it becomes a problem.">
<section class="relative py-16 lg:py-24 overflow-hidden"> <div class="absolute inset-0 bg-gradient-to-br from-navy via-graphite to-navy"></div> <div class="section-container relative"> <div class="grid lg:grid-cols-2 gap-12 items-center"> <div> <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">Architecture Before Software</h1> <p class="section-subtitle mt-6 whitespace-pre-line">ERP is a tool.
Without a system, it becomes a problem.</p> </div> <div class="relative flex justify-center"> <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-glow-lg bg-graphite max-w-[280px] lg:max-w-[320px]"> <img src="/images/owner-portrait.webp" alt="Karen Arutyunyan" class="w-full h-auto object-contain" width="585" height="1024" loading="lazy" decoding="async"> <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div> </div> </div> </div> </div>
</section>
<section class="py-16 lg:py-20"> <div class="section-container max-w-3xl mx-auto"> <h2 class="section-title text-center mb-12">Our ERP Approach</h2> <div class="space-y-4"> <div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">01</span> </div> <span class="text-gray-300 font-medium">Architecture first</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">02</span> </div> <span class="text-gray-300 font-medium">System selection second</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">03</span> </div> <span class="text-gray-300 font-medium">Implementation third</span> </div> </div> </div>
</section>
<section class="py-16 lg:py-20 bg-graphite/20"> <div class="section-container max-w-3xl mx-auto"> <div class="grid md:grid-cols-2 gap-6"> <div class="rounded-xl border border-white/10 bg-navy/60 p-8 border-l-4 border-l-cyan"> <p class="text-lg text-gray-200 whitespace-pre-line leading-relaxed">ERP does not manage business.
It reflects the system.</p> </div> <div class="rounded-xl border border-white/10 bg-navy/60 p-8 border-l-4 border-l-cyan"> <p class="text-lg text-gray-200 whitespace-pre-line leading-relaxed">If the system is weak —
ERP will expose it.</p> </div> </div> </div>
</section>
</Layout>
