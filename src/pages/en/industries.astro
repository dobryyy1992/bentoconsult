---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" page="industries" title="Industries | BentoConsult" description="Construction, Agriculture, Pet Products, Pharma &#38; Filtration.">
<section class="py-16 lg:py-24 bg-gradient-to-b from-graphite/50 to-navy"> <div class="section-container text-center"> <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">Industries</h1> </div>
</section>
<section class="py-16 lg:py-20"> <div class="section-container"> <div class="grid grid-cols-2 md:grid-cols-4 gap-6"> <div class="card text-center py-10 px-6"> <div class="mb-6 flex justify-center"> <svg class="w-14 h-14 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"> <path d="M3 21h18"></path> <path d="M5 21V11l7-5 7 5v10"></path> <path d="M10 15h4"></path> <path d="M10 21v-4h4v4"></path> </svg> </div> <h2 class="text-lg font-semibold leading-snug">Construction</h2> </div> <div class="card text-center py-10 px-6"> <div class="mb-6 flex justify-center"> <svg class="w-14 h-14 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"> <path d="M12 22V8"></path> <path d="M12 8c0-4 5-6 8-5-1 3-4 6-8 5z"></path> <path d="M12 8c0-4-5-6-8-5 1 3 4 6 8 5z"></path> <path d="M12 14c0-3 4-4 6-3-1 2-3 3-6 3z"></path> <path d="M12 14c0-3-4-4-6-3 1 2 3 3 6 3z"></path> </svg> </div> <h2 class="text-lg font-semibold leading-snug">Agriculture</h2> </div> <div class="card text-center py-10 px-6"> <div class="mb-6 flex justify-center"> <svg class="w-14 h-14 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"> <circle cx="9" cy="6" r="2"></circle> <circle cx="15" cy="6" r="2"></circle> <circle cx="6" cy="11" r="1.5"></circle> <circle cx="18" cy="11" r="1.5"></circle> <path d="M12 22c-4.5 0-7-2-7-5 0-2.5 2-4 4.5-4.5h5c2.5.5 4.5 2 4.5 4.5 0 3-2.5 5-7 5z"></path> </svg> </div> <h2 class="text-lg font-semibold leading-snug">Pet Products</h2> </div> <div class="card text-center py-10 px-6"> <div class="mb-6 flex justify-center"> <svg class="w-14 h-14 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"> <path d="M9 2h6"></path> <path d="M10 2v6l-4 8a2 2 0 001.8 2.9h8.4A2 2 0 0018 16l-4-8V2"></path> <line x1="8" y1="15" x2="16" y2="15"></line> </svg> </div> <h2 class="text-lg font-semibold leading-snug">Pharma &amp; Filtration</h2> </div> </div> </div>
</section>
</Layout>
