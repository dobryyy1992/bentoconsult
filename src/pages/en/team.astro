<Layout lang="en" page="team" title="TEAM — Enterprise Architecture Model | BentoConsult" description="TEAM is a system for designing enterprises.">
<section class="py-16 lg:py-24 bg-gradient-to-b from-graphite/50 to-navy"> <div class="section-container text-center"> <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">TEAM — Enterprise Architecture Model</h1> <p class="section-subtitle mx-auto mt-6 whitespace-pre-line">TEAM is a system for designing enterprises.
It defines business structure,
process logic, and system controllability.</p> </div>
</section>
<section class="py-16 lg:py-20"> <div class="section-container text-center"> <a href="/T3.png" target="_blank" rel="noopener noreferrer" class="relative inline-block max-w-lg rounded-2xl overflow-hidden border border-white/10 shadow-glow-lg bg-graphite cursor-zoom-in group" title="Click to view full size"> <img src="/images/T3.webp" alt="TEAM — Enterprise Architecture Model" class="block h-auto max-h-[calc(100vh-6rem)]" width="1024" height="1536" loading="lazy" decoding="async"> <div class="absolute bottom-3 right-3 bg-navy/80 text-xs text-gray-300 px-3 py-1 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity">Click to enlarge</div> </a> </div>
</section>
<section class="py-16 lg:py-20 bg-graphite/20"> <div class="section-container max-w-3xl mx-auto"> <h2 class="section-title text-center mb-12">7 Levels of Architecture</h2> <div class="space-y-4"> <div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">1</span> </div> <span class="text-gray-300 font-medium">Economics</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">2</span> </div> <span class="text-gray-300 font-medium">Processes</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">3</span> </div> <span class="text-gray-300 font-medium">Management</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">4</span> </div> <span class="text-gray-300 font-medium">Control</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">5</span> </div> <span class="text-gray-300 font-medium">ERP</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">6</span> </div> <span class="text-gray-300 font-medium">Automation</span> </div><div class="card flex items-center gap-4"> <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center"> <span class="text-sm font-bold text-cyan">7</span> </div> <span class="text-gray-300 font-medium">Analytics</span> </div> </div> </div>
</section>
</Layout>
